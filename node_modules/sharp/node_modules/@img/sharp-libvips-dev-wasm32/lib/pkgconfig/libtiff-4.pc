prefix=/src/build/target
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libtiff
Description:  Tag Image File Format (TIFF) library.
Version: 4.7.1
Libs: -L${libdir} -ltiff
Libs.private: -lwebp -ljpeg -lz -lm 
Cflags: -I${includedir}
Requires.private: libwebp libjpeg zlib 
